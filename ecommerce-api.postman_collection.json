							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"JWT Token saved automatically!\");",
									"}"
								],
								"type": "text/javascript"
							}
